# Browser-public API configuration. Leave empty for same-origin local/Netlify Dev.
VITE_API_BASE_URL=

# Server/function-only configuration. Never put credentials in VITE_* variables.
# Use exact origins separated by commas; do not use * when credentials are enabled.
HOC_VUI_ALLOWED_ORIGINS=http://localhost:8888
# Local Supabase/isolated PostgreSQL example:
HOC_VUI_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55422/postgres
# Cloud Supabase example (put the password in the process secret store, not here):
# HOC_VUI_DATABASE_URL=postgresql://hoc_vui_runtime.tvlpabqkternfvsxqovi@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
# Supabase Edge provides SUPABASE_DB_URL by default; prefer HOC_VUI_DATABASE_URL with the least-privileged runtime role.
# PGSSLMODE=require
HOC_VUI_DB_POOL_MAX=1
HOC_VUI_COOKIE_SECURE=false
APP_ORIGIN=http://localhost:8888
