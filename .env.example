# Placeholder-only template. Replace values in the target environment; never commit secrets.

# Browser-public API configuration. Use an empty value for same-origin local/Netlify Dev.
VITE_API_BASE_URL=<PUBLIC_EDGE_API_URL_OR_EMPTY>

# Server/function-only configuration. Never put database/auth secrets in VITE_* variables.
# Comma-separated exact origins only, for example the confirmed Firebase origin;
# add an exact custom domain or localhost origin only when that environment needs it.
HOC_VUI_ALLOWED_ORIGINS=<EXACT_ALLOWED_ORIGINS>
HOC_VUI_DATABASE_URL=<LOCAL_OR_CLOUD_RUNTIME_DATABASE_URL_FROM_SECRET_STORE>
# Supabase-provided fallback; this is not equivalent to the custom hoc_vui_runtime role.
SUPABASE_DB_URL=<SUPABASE_MANAGED_FALLBACK_DATABASE_URL>
PGSSLMODE=<require-for-cloud-or-local-policy>
HOC_VUI_DB_POOL_MAX=<POOL_SIZE>
HOC_VUI_COOKIE_SECURE=<true-for-https-or-false-for-local-http>
# Edge-only HMAC secret for opaque classroom Broadcast topics; generate a fresh random value.
HOC_VUI_REALTIME_TOPIC_SECRET=<RANDOM_EDGE_ONLY_SECRET>
APP_ORIGIN=<EXACT_LOCAL_APP_ORIGIN>
# Optional local-only HTTP benchmark token; set in the shell and never commit a real token.
